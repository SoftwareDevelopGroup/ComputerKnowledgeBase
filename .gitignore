# Share the complete Obsidian setup: core settings, plugins, plugin settings,
# snippets, themes, and other vault configuration.
!.obsidian/
!.obsidian/**

# Credential-bearing plugin data must stay local. Share sanitized examples
# separately if collaborators need the corresponding configuration shape.
.obsidian/plugins/remotely-save/data.json
.obsidian/plugins/obsidian-local-rest-api/data.json

.trash/
*.log
.DS_Store
Thumbs.db
*.swp
*.bak
*.tmp



# Ignore Smart Environment folder
.smart-env

# JetBrains / IntelliJ IDE files (leaked from contributor local environments)
.idea/
*.iml

# Per-user Obsidian plugin config (credential-bearing local state)
.obsidian/plugins/*/data.json

# WorkBuddy agent working files (project memory & backups stay local, not in the knowledge repo)
.workbuddy/
